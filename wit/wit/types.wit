/// Core types shared across all WAFER interfaces.

interface types {
    /// A key-value metadata entry. WIT has no map type, so we use a list of pairs.
    record meta-entry {
        key: string,
        value: string,
    }

    /// A message flowing through the block flow.
    record message {
        kind: string,
        data: list<u8>,
        meta: list<meta-entry>,
    }

    /// The action a block wants the runtime to take after processing a message.
    enum action {
        %continue,
        respond,
        drop,
        error,
    }

    /// A response payload returned when a block short-circuits the flow.
    record response {
        data: list<u8>,
        meta: list<meta-entry>,
    }

    /// gRPC-style error codes for WAFER.
    enum error-code {
        ok,
        cancelled,
        unknown,
        invalid-argument,
        deadline-exceeded,
        not-found,
        already-exists,
        permission-denied,
        resource-exhausted,
        failed-precondition,
        aborted,
        out-of-range,
        unimplemented,
        internal,
        unavailable,
        data-loss,
        unauthenticated,
    }

    /// A structured error returned by a block.
    record wafer-error {
        code: error-code,
        message: string,
        meta: list<meta-entry>,
    }

    /// The result of processing a message.
    record block-result {
        action: action,
        response: option<response>,
        error: option<wafer-error>,
        message: option<message>,
    }

    /// How many block instances are created and when.
    enum instance-mode {
        per-node,
        singleton,
        per-flow,
        per-execution,
    }

    // -----------------------------------------------------------------------
    // Schema declarations — blocks declare their database collections here.
    // -----------------------------------------------------------------------

    /// A field (column) in a collection.
    record field-def {
        /// Field name (e.g., "email", "price").
        name: string,
        /// Type: "string", "text", "int", "int64", "float", "bool", "datetime", "json", "blob".
        field-type: string,
        /// Whether this field must have a unique value.
        unique: bool,
        /// Whether this field can be NULL.
        optional: bool,
        /// JSON-encoded default value, or "" for none.
        default-value: string,
        /// Foreign key reference in "table.column" format, or "" for none.
        reference: string,
    }

    /// An index on a collection.
    record index-def {
        /// Column names in the index.
        fields: list<string>,
        /// Whether this is a unique index.
        unique: bool,
    }

    /// A database collection (table) declared by a block.
    record collection-def {
        /// Collection name (e.g., "auth_users", "block_products_products").
        name: string,
        /// Fields in this collection (excludes id, created_at, updated_at which are automatic).
        fields: list<field-def>,
        /// Indexes on this collection.
        indexes: list<index-def>,
    }

    /// Metadata describing a block.
    record block-info {
        name: string,
        version: string,
        %interface: string,
        summary: string,
        instance-mode: instance-mode,
        allowed-modes: list<instance-mode>,
        /// Database collections this block requires. The runtime ensures these
        /// tables exist when the block is registered.
        collections: list<collection-def>,
    }

    /// The kind of lifecycle event.
    enum lifecycle-type {
        init,
        start,
        stop,
    }

    /// A lifecycle event sent to blocks during transitions.
    record lifecycle-event {
        event-type: lifecycle-type,
        data: list<u8>,
    }
}
