/// A pure block interface for WaferFlow.
///
/// Pure blocks are fully sandboxed — they receive input bytes and return
/// output bytes with no host imports. This makes them deterministic,
/// portable, and safe to run in any environment.

interface pure-block {
    /// Process input and return output. Both are JSON-encoded bytes.
    handle: func(input: list<u8>) -> result<list<u8>, string>;

    /// Return block metadata as a JSON-encoded BlockDef string.
    info: func() -> string;
}
