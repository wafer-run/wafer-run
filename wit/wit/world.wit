/// WAFER Block World — the top-level component model definition.
///
/// Blocks import the runtime interface (which includes call-block for
/// inter-block communication) and export the block interface.
package wafer:block-world@0.2.0;

world wafer-block {
    import runtime;
    export block;
}

/// Pure Block World — a sandboxed component with no host imports.
///
/// Pure blocks are used in WaferFlow steps. They receive JSON input
/// and return JSON output with no side effects or host calls.
world wafer-pure-block {
    export pure-block;
}
